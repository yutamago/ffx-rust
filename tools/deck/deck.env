# The Steam Deck's settings for tools/deck/*.sh (docs/m6.md, "The Steam Deck").
# Sourced by tools/deck/lib.sh. The values that belong to one Deck (its address
# above all) go in ~/ffx-work/deck/deck.env (or the file DECK_ENV names), which is
# never in git and is read after this one; variables already set in the
# environment win over both.

# The Deck: its IP address or host name (empty: every script stops and says so),
# the user and the SSH key the user authorised for us.
DECK_HOST=
DECK_USER=deck
DECK_SSH_PORT=22
DECK_KEY="$HOME/.ssh/id_ffx_deck"

# Our own folder on the Deck, relative to the Deck user's home: the instances,
# the Proton prefix, the homes (Documents folders), the runs and the logs. We
# write nowhere else on the Deck.
DECK_WORK=ffx-deck

# The game folder on the Deck. Empty: found through Steam's libraryfolders.vdf
# (the library whose appmanifest_359870.acf names it). The game is only read.
DECK_GAME_DIR=

# The Proton to run with: a folder name under a library's steamapps/common or
# compatibilitytools.d ("Proton 9.0", "Proton - Experimental", "GE-Proton9-20"),
# or a path to the folder. Empty: the newest numbered "Proton N.N".
DECK_PROTON=

# Run Proton inside the Steam Linux Runtime container it asks for (its
# toolmanifest.vdf), as Steam does: auto (when Proton asks and the runtime is
# installed), 1 (required) or 0 (the proton script directly).
DECK_SLR=auto

# Where the window goes: auto (headless when the Deck's gamescope has the
# headless back end, else the running session's display), headless (a nested
# gamescope with no output: nothing on the screen), session (the display of
# Game Mode's or Desktop Mode's session, whichever runs: the window shows).
DECK_DISPLAY=auto

# Sound: 0 (default) plays into a null sink of ours, so nothing is heard;
# 1 uses the Deck's output (only when testing sound).
DECK_SOUND=0

# CPU priority of our games (nice; IO idle class as well).
DECK_NICE=19

# Steam for our games: 0 (default) gives the prefix no Steam client, unsets the
# app ids and sets FFX_NO_STEAM, so no run reaches the user's account; 1 hands
# Proton the real Steam client (M6-7's achievement checks only).
DECK_STEAM=0

# How --fixed-addresses (--virtual-clock) starts FFX.exe: launch (through
# ffx-launch.exe, as on Windows) or direct (FFX.exe itself, if Wine refuses the
# launcher's mitigation policy).
DECK_FIXED=launch

# The harness port on the Deck and on this machine (forwarded over SSH). Apart
# from this machine's own slots (27100 + n) so the two never meet.
DECK_HARNESS_PORT=27300

# This machine's side: the SSH control socket, the staged programs, the runs
# fetched back, the Deck's references (the original under Proton).
DECK_LOCAL_WORK="$HOME/ffx-work/deck"
