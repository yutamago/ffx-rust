0x023cc088 label    g_BtlWindowChr            # i16 character whose command window is open; TOCloseBtlWindow(it), then 0xff (TOBtlGetLeftPad/RightPad); name ours
0x023cc08c label    g_BtlWindowOpen           # zeroed by TOCloseBtlWindow
0x023cc092 label g_BtlActionDepth # i8 command-window level (TOBtlSetPrevAction decrements it); name ours
0x023cc120 label    g_TkMn2ListMax2           # TkMn2GetListMax2
0x023cc124 label    g_TkMenuSubCmdWindow2     # second sub-command window (MenuSubCmd_SetValue2)
0x023cc128 label    g_TkMenuSubCmdWindow      # the open sub-command window (TkMenuCloseSubCmdWindow sets its +0x41 and clears this; TkMenuRestartSubCmdWindow2)
0x023cc458 label    g_TkMn2FontShade          # 4 words 8 bytes apart, stored downwards: TkMn2SetFontShade(s0..s3) puts s0 at 0x023cc470, s3 here
0x025d06a0 label g_BtlSpecialTexture       # char[] the special texture's path (graphicMenuLoadSpecialTexture(8, it, 0) from MsBtlReadManage unless TkGetLang)
0x025d09c0 label    g_TOPadGetCtrl            # u8: SetTOPadGetCtrl
0x025d09d2 label    g_TOMenuPad               # 3 u16 (held, trg, rep): TOMenuGetControlPad/Trg/Rep return these when the dummy controller is on or held & 0xf000, else g_TOMenuPadAlt
0x025d09d8 label    g_TOMenuPad2              # u16: TOMenuGetControlPad2
0x025d09e2 label    g_TOMenuPadAlt            # 3 u16 (held, trg, rep), the other choice of TOMenuGetControlPad/Trg/Rep
0x025d16bc label    g_TkMenuTutoChosen        # set by MenuTuto_SetChoice
0x025d17a8 label    g_YiVramRegions              # image VRAM allocator: limits +0 (region 1), +4 (0 = g_YiVramLimit), +8, +0xc; next addresses +0x10, +0x14 (g_YiVramNext), +0x18, +0x1c (yiVramAllocPsm)
0x025d17ac label    g_YiVramLimit                # end of the image VRAM allocator (yiVramSetLimit)
0x025d17bc label    g_YiVramNext                 # its next free address, in bytes (yiVramAlloc)
0x025d1800 label    g_YiPolyBuf                  # the poly buffer: 0x4000 bytes of VU memory, then the VIF registers (yiPolyBufExecVif); +0x406c the last MSCAL's TOPS (yiPolySplitRectXZ reads the block there); name ours
0x025d58a0 label    g_RcbgClipWorldMatrix        # g_RcbgViewWorldMatrix through g_RcbgClipMatrix (rcbgUpdateMatrix)
0x025d58e0 label    g_RcbgClipMatrix             # rcbgSetClipMatrix
0x025d5920 label    g_RcbgScreenWorldMatrix      # g_RcbgViewWorldMatrix through g_ScreenMatrix (rcbgUpdateMatrix)
0x025d5960 label    g_RcbgViewWorldMatrix        # g_RcbgWorldMatrix through g_CameraMatrix (rcbgUpdateMatrix)
0x025d59a0 label    g_RcbgWorldMatrix            # rcbgSetWorldMatrix
0x025d59e0 label    g_RcefBaseMatrix          # name ours: the matrix rcefObjCalcLocalMatrix's flag 0x4000 multiplies in (after g_RcbgWorldMatrix)
0x025d5a20 label    g_RcefColorWork              # the effect's colour work (rcefWorkSet layout, +0x1c0..): rcefColorSet/rcefColorFade
0x025d5a24 label    g_RcefPrayEffect             # the pray effect rcEffectTaskPrayWait passes to op_pray_effect_check
0x025d5a28 label    g_RcefOef2                   # the effect's oef2 data: rcefPlaySE's op_oef2_a_get(it, 6, id)
0x025d5c18 label    g_RcefRequest                # rcefPostRequest's words: a, f, b, 0, c, d (+0..+0x14); no reader in the PC build
0x025d5c34 label    g_RcefRequestPending         # set by rcefPostRequest, awaited (0) by rcEffectTaskRequestWait; never cleared on PC
0x025d5c60 label    g_RcefTargets                # up to 16 effect targets, 0x24 bytes: u16 flags, +4 character, +8 distance, +0xc angle, +0x10 height, +0x14 direction (0x00924a20)
0x025d5ebc label    g_YnTest20Seen               # set by Yn_PreBgLayerDispOn when the path at 0x023cbc60 contains "te/test20" (strstr)
